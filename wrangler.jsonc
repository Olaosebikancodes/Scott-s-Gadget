// Cloudflare Workers config: serve the static build in out/ as plain files (no server code).
// Its presence stops `wrangler deploy` from trying to set the project up as a server-rendered Next.js app.
{
  "name": "scott-s-gadget",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./out",
    // /products/ipad-mini serves out/products/ipad-mini.html
    "html_handling": "auto-trailing-slash",
    // Unknown addresses get the site's own 404 page
    "not_found_handling": "404-page"
  }
}
